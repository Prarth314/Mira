{
  "name": "mira",
  "version": "0.1.0",
  "description": "A desktop voice workspace for developers with local transcription and deliberate prompt delivery.",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "npm run build:main && concurrently -k -n vite,electron \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "npm run build:main && vite build",
    "start": "cross-env NODE_ENV=production electron .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:main": "node scripts/build-main.mjs",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "package:dir": "npm run prepare:speech && npm run build && electron-builder --dir --publish never",
    "package": "npm run prepare:speech && npm run build && electron-builder --publish never",
    "test:e2e": "npm run build && playwright test",
    "prepare:speech": "node scripts/prepare-whisper.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,mts,js,mjs,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,mts,js,mjs,css}\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@babel/parser": "8.0.10",
    "framer-motion": "^12.38.0",
    "ignore": "^7.0.14",
    "lucide-react": "^1.8.0",
    "openai": "^6.34.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "systeminformation": "^5.33.19"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.0.8",
    "vitest": "^5.0.5",
    "wait-on": "^9.0.5"
  },
  "license": "MIT",
  "author": "Mira contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/Prarth314/Mira.git"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "build": {
    "appId": "dev.mira.desktop",
    "productName": "Mira",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "LICENSE",
      "docs/THIRD_PARTY_NOTICES.md"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Mira records audio only when you start a voice session."
      },
      "icon": "build/icon.png"
    },
    "publish": null,
    "extraResources": [
      {
        "from": "vendor/whisper/runtime",
        "to": "whisper",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
